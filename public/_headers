# Default: short cache for everything that is not versioned (HTML, robots, sitemap, icon, og image path).
/*
  Cache-Control: public, max-age=0, must-revalidate

# Unversioned media fallback: short cache.
/media/*
  ! Cache-Control
  Cache-Control: public, max-age=3600, must-revalidate

# Every file under these folders carries a version in its name (*.v1.*) or folder (seq-1080.v1/);
# replacing an asset means a new name.
/media/intro/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/media/fx/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/media/work/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/og.v1.jpg
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Content-hashed build output.
/_next/static/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
